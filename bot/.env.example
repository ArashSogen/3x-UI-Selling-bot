# Telegram Bot Configuration
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Comma-separated list of hardcoded Admin Telegram IDs
ADMIN_IDS=123456789,987654321

# 3x-ui Panel Configuration
# URL of your 3x-ui panel without trailing slash, e.g., https://panel.example.com:2053 or http://1.2.3.4:2053
XUI_URL=https://panel.example.com:2053
# Web base path if configured in 3x-ui (default is empty or /)
XUI_WEB_BASE_PATH=
XUI_USERNAME=admin
XUI_PASSWORD=your_secure_password

# Payment Card Default Settings (can also be changed directly inside the bot by admins)
DEFAULT_CARD_NUMBER=4400 1234 5678 9012
DEFAULT_CARD_HOLDER=John Doe (VPN Merchant)

# Database
DATABASE_PATH=vpn_bot.db
